# Copy to .env and fill in whatever you have. Everything is optional:
# with no keys at all, the site still works using Pollinations (slow, ~1 image / 16 s).

PORT=3000
TARGET_POOL=500         # keep the newest 500 faces on disk (oldest deleted first)
ROTATE=1                # 1 = keep generating and replacing the oldest; 0 = stop at TARGET_POOL
FRESH_MIN=20            # visitors see only the newest Kaggle batch; if it has < 20 faces, top up with the newest overall
FALLBACK_UNTIL=1        # local-data/ is shown only while the pool has fewer than this many faces (1 = only when empty)
CONCURRENCY=3           # images generated in parallel (each provider still runs one at a time)
PROVIDER_ORDER=local,gemini,modelscope,cloudflare,zhipu,siliconflow,muapi,pollinations

# ---------------- FREE GPU: Kaggle batches (fully automatic) ----------------
# The server pushes a batch of prompts to a private Kaggle GPU notebook, waits, and imports the faces.
# Needs: `pip install kaggle`, a phone-verified Kaggle account, and an API token (kaggle.com/settings -> API).
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=          # new-style token, or use KAGGLE_KEY= from kaggle.json instead
KAGGLE_BATCH_SIZE=120      # faces per run
KAGGLE_EVERY_HOURS=24      # how often to start a run (Kaggle gives ~30 GPU h/week)
KAGGLE_MAX_MINUTES=150     # stop each run early so it never hits Kaggle's 12 h limit
KAGGLE_MODEL=zimage        # zimage (Z-Image-Turbo, falls back to RealVisXL) | sdxl
KAGGLE_CMD=kaggle          # or: python -m kaggle

# ---------------- FREE image models ----------------

# Alibaba ModelScope (Z-Image-Turbo, Qwen-Image). Best free photorealism.
# Token: modelscope.cn -> Access Tokens. Their free API needs a linked, verified Alibaba Cloud account.
MODELSCOPE_TOKEN=
MODELSCOPE_MODELS=Tongyi-MAI/Z-Image-Turbo,Qwen/Qwen-Image
MODELSCOPE_DAILY_LIMIT=300

# Cloudflare Workers AI. 10,000 free neurons/day.
# flux-2-klein-4b ≈ 90 free images/day (default) · flux-2-klein-9b ≈ 7/day, sharper · flux-1-schnell = old
# dash.cloudflare.com -> AI -> Workers AI -> Use REST API
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CF_DAILY_LIMIT=90

# Zhipu BigModel, China (CogView-3-Flash is free). open.bigmodel.cn -> API keys (phone verification)
ZHIPU_API_KEY=
ZHIPU_CROP_BOTTOM=0.07  # crops the "AI generated" corner mark if your account can't turn it off

# SiliconFlow (Kwai Kolors). Check current pricing — Kolors has been free there before.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE=https://api.siliconflow.cn/v1   # or https://api.siliconflow.com/v1 (international)

# Pollinations: works without a key. A free key from enter.pollinations.ai makes it faster.
POLLINATIONS_KEY=
POLLINATIONS_CROP_PX=96  # bottom strip cut off to remove the watermark (out of 1120 px)
POLLINATIONS_DISABLED=0

# ---------------- PAID / self-hosted extras ----------------

# Google Gemini "Nano Banana" images (aistudio.google.com -> Get API key). Image models need billing
# turned on (~$0.03-0.04/image). The same key gives FREE Gemini text for prompt polishing.
GEMINI_API_KEY=
GEMINI_IMAGES=1                # 0 = use the key only for free text polishing
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_DAILY_LIMIT=30

# Muapi.ai — the API behind github.com/Anil-matcha/Open-Generative-AI. Paid per image.
MUAPI_KEY=
MUAPI_MODELS=z-image-turbo,flux-krea-dev,hunyuan-image-3.0
MUAPI_DAILY_LIMIT=50

# Your own GPU running AUTOMATIC1111 / Forge / SD.Next with --api (e.g. http://127.0.0.1:7860)
LOCAL_SD_URL=

# ---------------- FREE LLMs: prompt polishing ----------------
# Rewrites the template prompt into natural photographer language. Off if no key below is set.
LLM_POLISH=1
LLM_ORDER=gemini,openrouter,modelscope,zhipu
GEMINI_LLM=gemini-2.5-flash
OPENROUTER_API_KEY=            # openrouter.ai — free DeepSeek, ~50 requests/day on a free account
OPENROUTER_MODELS=deepseek/deepseek-v4-flash:free,openrouter/free
MODELSCOPE_LLM=deepseek-ai/DeepSeek-V3.2   # any LLM with "API-Inference" on its ModelScope page
ZHIPU_LLM=glm-4.7-flash

# ---------------- FREE vision QA: reject bad images ----------------
# A free vision model looks at every image and drops ones that don't look like a real photo.
QA_PROVIDER=                   # zhipu (glm-4.6v-flash) or modelscope (Qwen3-VL); empty = off
QA_MIN_SCORE=6

# ---------------- FairFace calibration ----------------
FAIRFACE_BLEND=0.5             # how much data/fairface_calibration.json overrides the JSON weights
